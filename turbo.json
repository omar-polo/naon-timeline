{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "openapi": {
      "outputs": ["openapi.json"]
    },
    "@naon-timeline/api-client#build": {
      "dependsOn": ["@naon-timeline/backend#openapi"],
      "outputs": ["src/schema.ts"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "preview": {
      "cache": false,
      "persistent": true
    }
  }
}
